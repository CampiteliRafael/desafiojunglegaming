DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wagering
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PORT=3000
LOG_LEVEL=info
# which background workers run in this instance (all true by default)
ENABLE_SQS_CONSUMER=true
ENABLE_OUTBOX_PUBLISHER=true
ENABLE_PENDING_REFERENCE_WORKER=true
