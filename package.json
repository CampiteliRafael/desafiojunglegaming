{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "bun run src/infrastructure/persistence/cli/migrate.ts up",
    "migrate:down": "bun run src/infrastructure/persistence/cli/migrate.ts down",
    "test": "bun test tests/unit",
    "test:integration": "bun test --timeout 60000 tests/integration",
    "test:concurrency": "bun test --timeout 120000 tests/concurrency",
    "test:all": "bun test --timeout 120000 tests",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f docker-compose.test.yml down -v",
    "test:load": "bun run tests/load/load-test.ts",
    "test:db:reset": "bun run src/infrastructure/persistence/cli/migrate.ts down && bun run src/infrastructure/persistence/cli/migrate.ts up"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1146.0",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/postgresql": "^6",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "typescript": "~5.9"
  }
}